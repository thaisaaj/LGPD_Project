# ============================================================
# Agente de IA - copie este arquivo para ".env" e preencha.
# Basta UM provedor. Nenhum exige instalar nada no computador.
# ============================================================

# Provedor: ollama | groq | gemini | openrouter | anthropic
LGPD_IA_PROVEDOR=ollama

# --- Ollama Cloud (gratuito) - crie a chave em https://ollama.com/settings/keys
OLLAMA_API_KEY=

# --- Groq (gratuito) - https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Gemini (gratuito) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OpenRouter (modelos ":free") - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Claude / Anthropic (pago) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: trocar o modelo padrão do provedor
# (padrões: ollama=gpt-oss:120b | groq=openai/gpt-oss-120b | gemini=gemini-flash-latest
#           openrouter=openai/gpt-oss-120b:free | anthropic=claude-opus-5-5)
LGPD_IA_MODELO=
